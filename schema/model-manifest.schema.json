{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varmeta.dev/schema/model-manifest.schema.json",
  "title": "ModelManifest",
  "type": "object",
  "required": ["version", "minAppVersion", "files"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "minAppVersion": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256", "url"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
